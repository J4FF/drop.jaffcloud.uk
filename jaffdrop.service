[Unit]
Description=JaffDrop file sharing service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jaff
WorkingDirectory=/home/jaff/apps/drop
Environment=NODE_ENV=production
Environment=DROP_HOST=0.0.0.0
Environment=DROP_PORT=8787
ExecStart=/usr/bin/node /home/jaff/apps/drop/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/jaff/apps/drop

[Install]
WantedBy=multi-user.target
